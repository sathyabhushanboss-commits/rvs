# Public site URL (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.rvstoursandtravels.com

# Razorpay — dashboard.razorpay.com → Account & Settings → API Keys
# Use rzp_test_... keys while testing, rzp_live_... after KYC/activation
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# SMTP for booking / enquiry emails (Gmail: smtp.gmail.com, 465, app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=bookings@rvstoursandtravels.com
SMTP_PASS=your-app-password
MAIL_FROM="RVS Tours and Travels <bookings@rvstoursandtravels.com>"
# Where new bookings/enquiries are delivered (comma-separated allowed)
BOOKING_EMAIL_TO=info@rvstoursandtravels.com
